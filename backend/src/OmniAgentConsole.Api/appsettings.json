{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=omniagent_console;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4210"
    ]
  },
  "Providers": {
    "OmniAgent": {
      "BaseUrl": "https://integrate.api.nvidia.com/v1",
      "ApiKeyEnvironmentVariable": "OMNIAGENT_API_KEY",
      "ApiKeySecretName": "secret/providers/omniagent#apiKey",
      "DefaultModel": "meta/llama-3.1-8b-instruct",
      "TimeoutSeconds": 120,
      "RetryCount": 2
    }
  },
  "Vault": {
    "Enabled": false,
    "Address": "http://localhost:8201",
    "Token": "dev-root-token",
    "Mount": "secret",
    "OmniAgentApiKeyPath": "providers/omniagent"
  },
  "TaskQueue": {
    "Mode": "InMemory",
    "QueueName": "omniagent-console.task-runs",
    "PollIntervalMilliseconds": 500
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
