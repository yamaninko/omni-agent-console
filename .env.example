OMNIAGENT_BASE_URL=https://integrate.api.nvidia.com/v1
OMNIAGENT_DEFAULT_MODEL=meta/llama-3.1-8b-instruct
OMNIAGENT_API_KEY_SECRET_NAME=secret/providers/omniagent#apiKey

# Provider API key fallback when Vault is unavailable (Vault dev mode loses data on restart)
OMNIAGENT_API_KEY=

# Console API key protecting the backend REST/SignalR surface.
# Leave empty for anonymous local development; set a strong value for any shared deployment.
CONSOLE_API_KEY=

# GitHub integration.
# GITHUB_URL: repository URL, e.g. https://github.com/<owner>/<repo>
# GITHUB_API_KEY: personal access token (ghp_... / github_pat_...).
#                 Leave EMPTY here — fill it only in your local .env, which is
#                 gitignored. Never commit a real token.
GITHUB_URL=
GITHUB_API_KEY=

FRONTEND_HOST_PORT=4210
BACKEND_HOST_PORT=5080
VAULT_HOST_PORT=8201
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
# Mirror Vault secrets to ./data/secrets (survives vault -dev recreate). Set false to disable.
FILE_SECRET_MIRROR=true
POSTGRES_DB=omniagent_console
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
RABBITMQ_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
TASK_QUEUE_MODE=RabbitMq
TASK_QUEUE_NAME=omniagent-console.task-runs

# Stalled-task watchdog: reports a Running task whose console has gone quiet and
# finally marks it Failed, so the Studio never spins forever on a lost queue message.
# Warning threshold must stay above the slowest agent timeout (Coder = 300s).
TASK_WATCHDOG_ENABLED=true
TASK_WATCHDOG_WARN_MINUTES=10
TASK_WATCHDOG_FAIL_MINUTES=20
# Worker empty-queue poll (ms). Higher = less idle CPU on Windows Docker Desktop.
TASK_QUEUE_POLL_INTERVAL_MS=1500

POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=omniagent_console;Username=postgres;Password=postgres
REDIS_CONNECTION_STRING=redis:6379
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@rabbitmq:5672
OPENSEARCH_URL=http://opensearch:9200

# Host interface for infra ports (Postgres/Redis/RabbitMQ/Vault/OpenSearch).
# Default 127.0.0.1 keeps secret-carrying services off the local network;
# set 0.0.0.0 only for isolated lab networks that need remote access.
INFRA_BIND_ADDRESS=127.0.0.1

# Deployment profile (see docs/ROADMAP.md §1 and README "Deployment modelleri").
# false (default) = single-user laptop profile, today's behavior.
# true = shared-lab profile: session-scoped tasks/workspaces, settings locked
#        for students. REQUIRES CONSOLE_API_KEY — the app refuses to start
#        without it (fail-fast) to prevent anonymous shared deployments.
SHARED_LAB=false
# Student quotas when SHARED_LAB=true (0 = unlimited). Bound as SharedLab__*
# SHARED_LAB_MAX_CONCURRENT_TASKS=2
# SHARED_LAB_MAX_TASKS_PER_DAY=30
# SHARED_LAB_MAX_DAILY_TOKENS=500000

# Panel floor order: fixed (roster) | llm (heuristic + parse last moderator speech)
# PANEL_FLOOR_MODE=fixed

# Host folder whose top-level project dirs can be **copied into ./workspace**
# from the Workspace UI ("Add project" → copy from host).
# Example (macOS): HOST_IMPORT_DIR=/Users/you/projects
# Leave empty / unset to use the empty stub ./data/host-import (browser upload still works).
HOST_IMPORT_DIR=
WORKSPACE_IMPORT_ENABLED=true

# Workspace project runner (one-click docker compose up from the Workspace UI).
# Requires Docker socket mounted into backend-api (see docker-compose.yml).
WORKSPACE_RUNNER_ENABLED=true
WORKSPACE_RUNNER_PORT_START=18000
WORKSPACE_RUNNER_PORT_SIZE=1000
WORKSPACE_RUNNER_MAX_CONCURRENT=3
WORKSPACE_RUNNER_BUILD_TIMEOUT=300
# From inside backend-api container; browser still uses localhost.
WORKSPACE_RUNNER_HEALTH_HOST=host.docker.internal
